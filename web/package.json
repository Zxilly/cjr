{
  "name": "cjr-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "test:unit": "vitest run",
    "test:built": "node --test test/*.test.mjs",
    "test": "npm run lint && npm run test:unit && npm run build && npm run test:built",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource/patua-one": "5.3.0",
    "@radix-ui/react-tabs": "1.2.1",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "8.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cheerio": "1.2.0",
    "jsdom": "31.0.0",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
